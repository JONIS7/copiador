{
  "manifest_version": 3,
  "name": "Copiador de Formulários",
  "version": "1.0",
  "description": "Copia dados de um formulário em um site e cola em outro.",
  "permissions": [
    "storage",
    "activeTab",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
